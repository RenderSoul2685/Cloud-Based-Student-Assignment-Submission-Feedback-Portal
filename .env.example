# ==============================================================================
# Environment Configuration - Cloud-Based Student Assignment Submission Portal
# Stack: Next.js (Frontend) + FastAPI (Backend) + Firebase Spark Plan (Auth, Firestore, Storage)
# DO NOT COMMIT REAL SERVICE ACCOUNT KEYS OR API KEYS TO VERSION CONTROL.
# ==============================================================================

# Application Environment
ENVIRONMENT=development
LOG_LEVEL=info
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
FRONTEND_PORT=3000
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000/api

# ------------------------------------------------------------------------------
# Firebase Admin SDK Configuration (FastAPI Backend)
# ------------------------------------------------------------------------------
FIREBASE_PROJECT_ID=your-firebase-project-id
FIREBASE_STORAGE_BUCKET=your-firebase-project-id.firebasestorage.app
FIREBASE_SERVICE_ACCOUNT_PATH=./serviceAccountKey.json

# (Optional) Firebase Local Emulator Suite (For Offline Dev / CI Testing)
# Set these if running `firebase emulators:start` locally:
# FIRESTORE_EMULATOR_HOST=localhost:8080
# FIREBASE_AUTH_EMULATOR_HOST=localhost:9099
# FIREBASE_STORAGE_EMULATOR_HOST=localhost:9199

# ------------------------------------------------------------------------------
# Firebase Client SDK Configuration (Next.js Frontend)
# ------------------------------------------------------------------------------
NEXT_PUBLIC_FIREBASE_API_KEY=AIzaSy_your_web_api_key_placeholder
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=your-firebase-project-id.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=your-firebase-project-id
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=your-firebase-project-id.firebasestorage.app
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=123456789012
NEXT_PUBLIC_FIREBASE_APP_ID=1:123456789012:web:abcdef1234567890
